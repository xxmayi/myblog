---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Comments from '../../components/Comments.astro';
import { getPosts, categoryColor } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);
const color = categoryColor(post.data.category);

// 按固定栏目顺序分组，仅保留有文章的栏目
const CATEGORY_ORDER = ['日常碎碎念', '旅行足迹', '读书观影', '美食厨房', '手作'];
const grouped = CATEGORY_ORDER.map((cat) => ({
  category: cat,
  posts: allPosts.filter((p) => p.data.category === cat),
})).filter((g) => g.posts.length > 0);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover}
>
  <div class="post-layout">
    <aside class="post-toc" aria-label="文章目录">
      <p class="toc-title">文章目录</p>
      {grouped.map((group) => (
        <div class="toc-group">
          <p class="toc-group-title" style={`color:${categoryColor(group.category)}`}>
            {group.category}
          </p>
          <ul class="toc-list">
            {group.posts.map((p) => (
              <li>
                <a
                  href={import.meta.env.BASE_URL + `posts/${p.id}/`}
                  class={`toc-item${p.id === post.id ? ' active' : ''}`}
                  aria-current={p.id === post.id ? 'page' : undefined}
                >
                  <span class="toc-text">{p.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </aside>

    <article class="post">
    {
      post.data.cover && (
        <img src={post.data.cover} alt={post.data.title} class="post-cover" />
      )
    }
    <span class="chip" style={`background:${color}1a;color:${color}`}>
      {post.data.category}
    </span>
    <h1>{post.data.title}</h1>
    <p class="post-meta"><FormattedDate date={post.data.pubDate} /></p>

    <div class="prose">
      <Content />
    </div>

    {
      post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map((t) => (
            <a href={import.meta.env.BASE_URL + `tags/${encodeURIComponent(t)}/`} class="tag">
              #{t}
            </a>
          ))}
        </div>
      )
    }

    <Comments />
  </article>
  </div>
</BaseLayout>
